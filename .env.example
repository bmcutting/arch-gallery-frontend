# Copia este archivo como .env y rellena los valores.
# En Vercel, estas mismas variables se definen en
# Settings -> Environment Variables (el .env no se versiona).

# URL base del backend. Sin barra final.
# Local:      http://localhost:3000
# Producción: https://<tu-api>
VITE_API_URL=

# Entorno de la app: development | production
VITE_ENV=development
